{
  "name": "ryla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx scripts/preflight.ts && next dev",
    "build": "next build",
    "build:clean": "rm -rf .next node_modules/.cache && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "./scripts/pg.sh start",
    "db:down": "./scripts/pg.sh stop",
    "db:psql": "./scripts/pg.sh psql",
    "db:destroy": "./scripts/pg.sh destroy",
    "db:check": "tsx scripts/db-check.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:baseline": "tsx db/migrate.ts --baseline",
    "db:reset": "tsx db/migrate.ts --reset",
    "db:seed": "tsx db/seed.ts",
    "cabinet:create": "tsx scripts/create-cabinet.ts",
    "cabinet:sql": "tsx scripts/export-cabinet-sql.ts",
    "smoke": "tsx scripts/smoke.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "setup": "npm run db:up && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "next": "^15.5.4",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
