# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# Deux URL, et ce n'est pas une commodité :
#
#   DATABASE_ADMIN_URL : rôle propriétaire. Migrations et seed uniquement.
#   DATABASE_URL       : rôle applicatif. NON superuser, NON propriétaire des
#                        tables, donc réellement soumis au RLS.
#
# Faire pointer DATABASE_URL sur le rôle propriétaire supprime l'isolation
# entre cabinets sans le moindre message d'erreur : PostgreSQL exempte le
# propriétaire d'une table de ses propres politiques. `npm run db:check`
# vérifie ce point ; l'application refuse de démarrer si c'est le cas.
DATABASE_URL=postgres://ryla_app:ryla_app@localhost:54329/ryla
DATABASE_ADMIN_URL=postgres://ryla:ryla@localhost:54329/ryla

# --- Supabase (transitoire — voir la section Hébergement du README) ---------
# ⚠️  Supabase n'est pas certifié HDS : aucune donnée de santé réelle.
#
# Migrations : connexion « Session pooler » ou directe, rôle postgres.
# DATABASE_ADMIN_URL=postgres://postgres.<ref>:<mdp>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Application : « Transaction pooler » (port 6543), rôle ryla_app créé par la
# migration 0002. Le pooler impose le suffixe .<ref> dans le nom d'utilisateur,
# et les instructions préparées sont désactivées automatiquement.
# DATABASE_URL=postgres://ryla_app.<ref>:<mdp>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Force la désactivation des instructions préparées si la détection automatique
# du pooler ne suffit pas.
# DATABASE_DISABLE_PREPARE=true

# ---------------------------------------------------------------------------
# Cryptographie
# ---------------------------------------------------------------------------
# KEK maître (Key Encryption Key). En production : KMS/HSM du prestataire HDS,
# jamais une variable d'environnement en clair.
# Génération : openssl rand -base64 32
RYLA_KEK=cnlsYS1kZXYta2V5LURPLU5PVC1VU0UtSU4tUFJPRCE=

# Secret HMAC pour les jetons de lien magique et les cookies de session.
# Génération : openssl rand -base64 48
RYLA_TOKEN_SECRET=cnlsYS1kZXYtdG9rZW4tc2VjcmV0LURPLU5PVC1VU0UtSU4tUFJPRFVDVElPTi0wMDAx

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
# Domaine racine des sous-domaines par cabinet (cabinet-martin.ryla.fr)
APP_TENANT_DOMAIN=localhost:3000

# Durée de validité d'un lien patient (heures)
MAGIC_LINK_TTL_HOURS=168

# Stockage objet des PDF. En production : bucket HDS (Scaleway / OVHcloud).
# Stockage des PDF signés.
#   postgres — défaut. Portable, soumis au RLS, seul pilote viable en serverless.
#   local    — écrit dans ./storage. Inutilisable sur Vercel (disque éphémère).
#   s3       — cible de production : bucket Object Storage sous périmètre HDS.
STORAGE_DRIVER=postgres
STORAGE_LOCAL_DIR=./storage
